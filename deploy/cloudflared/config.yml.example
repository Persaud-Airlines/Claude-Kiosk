# OPTIONAL. Cloudflare Tunnel is normally set up in the Zero Trust dashboard (Networks > Tunnels) and installed
# with a token by deploy\windows\install.ps1. Use this file only if you manage the tunnel locally.
#
#   1. Install cloudflared (cloudflared-windows-amd64.msi from github.com/cloudflare/cloudflared/releases)
#   2. cloudflared tunnel login
#   3. cloudflared tunnel create detechtive
#   4. Copy this file to C:\Users\<you>\.cloudflared\config.yml and fill in the tunnel id and hostname
#   5. cloudflared tunnel route dns detechtive edu.detechtive.ca
#   6. cloudflared service install        (installs the Windows service that runs the tunnel)
#
# The route for edu.detechtive.ca must point at http://localhost:8000 (the DE-TECH-TIVE server).
tunnel: <TUNNEL-UUID>
credentials-file: C:\Users\<you>\.cloudflared\<TUNNEL-UUID>.json
ingress:
  - hostname: edu.detechtive.ca
    service: http://localhost:8000
    originRequest:
      connectTimeout: 10s
      noTLSVerify: false
  - service: http_status:404
