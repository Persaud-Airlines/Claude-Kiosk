# ============================================================================
# DE-TECH-TIVE TECHNOLOGIES Inc — Master/Host configuration
# Copy to backend/.env and edit. NEVER commit the real .env.
# ============================================================================
ENVIRONMENT=development            # development | production
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8000   # where staff open the portal (used in kiosk QR codes)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Database: SQLite quickstart (one flag) or PostgreSQL --------------------
USE_SQLITE=true
SQLITE_PATH=./data/detechtive.db
DATABASE_URL=postgresql+asyncpg://detechtive:detechtive@localhost:5432/detechtive

# --- Secrets (generate with: python scripts/gen_secrets.py) ---------------
JWT_SECRET=CHANGE-ME-dev-only-jwt-secret-please-rotate-0123456789
FIELD_ENCRYPTION_KEY=pV0eY2m3eYp0Zr6h0bq7lJm0Wq4p8i7rN1hS5aT9cXk=
SECURE_COOKIES=false               # true when served over HTTPS
TRUST_PROXY_HEADERS=false          # true behind Cloudflare Tunnel / nginx

# --- First SUPERSUDO account (created only when the users table is empty) ---
BOOTSTRAP_SUPERSUDO_EMAIL=admin@detechtive.local
# Leave blank to auto-generate; the password is written to data/INITIAL_ADMIN_PASSWORD.txt (chmod 600)
BOOTSTRAP_SUPERSUDO_PASSWORD=

# --- OCR ------------------------------------------------------------------
OCR_ENGINE=auto                    # auto | paddle | easyocr | tesseract | none
OCR_MIN_CONFIDENCE=0.60
# TESSERACT_LANG=eng+fra+spa       # install extra language packs with brew install tesseract-lang

# --- Stripe ($19.99/month per school) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SCHOOL_MONTHLY=
SCHOOL_MONTHLY_PRICE_CENTS=1999

# --- Data retention ------------------------------------------------------------
DATA_RETENTION_DAYS=400
